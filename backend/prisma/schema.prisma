// ============================================================================
// MAHA-AGRI Government Digital Operations Platform
// Prisma Multi-Schema Specification (PostgreSQL 16 + PostGIS Spatial Engine)
// Schemas:
// 1. platform: Shared Core Platform Infrastructure Services (v1.0)
// 2. edp: EDP Agri Drone Enterprise Module (v1.0.2)
// 3. soil: Soil Testing Operations Module (v1.0.2)
// 4. workforce: MAHA-AGRIDOOT Workforce Module (v1.0)
// 5. farmer: Shared Farmer Master Module System of Record (v1.0)
// 6. ops: Phase B Operational Excellence & Observability Framework (v1.1)
// 7. scale: Phase C Statewide Scale, Multi-Tenant Operations & Reliability (v1.2)
// 8. security: Phase D Enterprise Security, Compliance & Assurance (v1.3)
// 9. integration: Phase E Enterprise Integration & Ecosystem Framework (v1.4)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "edp", "soil", "workforce", "farmer", "ops", "scale", "security", "integration"]
}

// ----------------------------------------------------------------------------
// Shared Platform Core Enums
// ----------------------------------------------------------------------------
enum UserRoleType {
  SUPER_ADMIN
  STATE_ADMIN
  DISTRICT_COORDINATOR
  TALUKA_COORDINATOR
  MAHA_AGRIDOOT
  LAB_ADMIN
  LAB_TECHNICIAN
  ENTREPRENEUR
  DRONE_PILOT
  FINANCE_OFFICER
  FARMER

  @@schema("platform")
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH

  @@schema("platform")
}

enum AuditActionType {
  USER_LOGIN
  USER_LOGOUT
  RECORD_CREATED
  RECORD_UPDATED
  RECORD_DELETED
  STATE_TRANSITION
  SECURITY_VIOLATION

  @@schema("platform")
}

enum WorkforceStatus {
  APPLIED
  SCREENING
  VERIFIED
  SELECTED
  APPOINTED
  TRAINED
  ACTIVE
  TRANSFERRED
  PROMOTED
  SUSPENDED
  EXITED

  @@schema("workforce")
}

enum SharedFarmerStatus {
  REGISTERED
  KYC_VERIFIED
  ACTIVE
  MERGED
  ARCHIVED

  @@schema("farmer")
}

enum IncidentSeverity {
  P1_CRITICAL
  P2_MAJOR
  P3_MINOR
  P4_COSMETIC

  @@schema("ops")
}

enum IncidentStatus {
  LOGGED
  INVESTIGATING
  RESOLVED
  CLOSED

  @@schema("ops")
}

enum DistrictRolloutStage {
  NOT_STARTED
  ASSESSMENT
  INFRASTRUCTURE_READY
  WORKFORCE_DEPLOYED
  PILOT_ACTIVE
  PRODUCTION_LIVE

  @@schema("ops")
}

// ============================================================================
// PHASE E ENTERPRISE INTEGRATION TABLES (v1.4) (schema: "integration")
// ============================================================================

model IntegPartner {
  id               String   @id @default(uuid()) @db.Uuid
  partnerCode      String   @unique @db.VarChar(50)
  partnerName      String   @db.VarChar(150)
  partnerType      String   @db.VarChar(50) // GOVT_AGENCY, LAB, TECH_PARTNER, BANK
  isActive         Boolean  @default(true)
  slaCompliancePct Decimal  @db.Decimal(5, 2)

  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  apiKeys          IntegApiKey[]

  @@map("integ_partners")
  @@schema("integration")
}

model IntegApiKey {
  id               String       @id @default(uuid()) @db.Uuid
  partnerId        String       @db.Uuid
  keyPrefix        String       @db.VarChar(20)
  secretHash       String       @db.Text
  rateLimitPerMin  Int          @default(60)
  expiresAt        DateTime     @db.Timestamptz
  isActive         Boolean      @default(true)

  partner          IntegPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("integ_api_keys")
  @@schema("integration")
}

model IntegGisLayer {
  id               String   @id @default(uuid()) @db.Uuid
  layerCode        String   @unique @db.VarChar(50)
  layerName        String   @db.VarChar(100)
  geometryType     String   @db.VarChar(30) // POLYGON, POINT, MULTIPOLYGON
  featureCount     Int      @default(0)
  isPublic         Boolean  @default(true)

  @@map("integ_gis_layers")
  @@schema("integration")
}

model IntegPaymentOrder {
  id               String            @id @default(uuid()) @db.Uuid
  orderCode        String            @unique @db.VarChar(50) // Cashfree order_id
  candidateId      String?           @db.Uuid                // Strict FK to EdpCandidate.id
  candidateCode    String            @db.VarChar(50)         // Business candidateCode
  gatewayName      String            @default("CASHFREE") @db.VarChar(50)
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("INR") @db.VarChar(10)
  status           String            @default("ACTIVE") @db.VarChar(30) // ACTIVE, PAID, EXPIRED
  paymentSessionId String?           @db.Text
  paymentLink      String?           @db.Text
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamptz

  transactions     IntegPaymentTxn[]

  @@index([candidateId])
  @@index([candidateCode])
  @@map("integ_payment_orders")
  @@schema("integration")
}

model IntegPaymentTxn {
  id               String            @id @default(uuid()) @db.Uuid
  txnCode          String            @unique @db.VarChar(50) // cf_payment_id
  orderId          String?           @db.Uuid
  orderCode        String?           @db.VarChar(50)
  candidateId      String?           @db.Uuid
  candidateCode    String?           @db.VarChar(50)
  gatewayName      String            @db.VarChar(50)
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("INR") @db.VarChar(10)
  status           String            @db.VarChar(30) // Actual verified status: SUCCESS, FAILED, PENDING, etc.
  settledAt        DateTime?         @db.Timestamptz
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamptz

  order            IntegPaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderCode])
  @@index([candidateId])
  @@index([candidateCode])
  @@map("integ_payment_txns")
  @@schema("integration")
}

model IntegDataJob {
  id               String   @id @default(uuid()) @db.Uuid
  jobCode          String   @unique @db.VarChar(50)
  jobType          String   @db.VarChar(50) // IMPORT, EXPORT, SYNC
  targetSystem     String   @db.VarChar(100)
  recordCount      Int      @default(0)
  status           String   @default("COMPLETED") @db.VarChar(30)
  executedAt       DateTime @default(now()) @db.Timestamptz

  @@map("integ_data_jobs")
  @@schema("integration")
}

// ============================================================================
// PHASE D ENTERPRISE SECURITY & COMPLIANCE TABLES (v1.3) (schema: "security")
// ============================================================================
model SecSecurityEvent {
  id               String   @id @default(uuid()) @db.Uuid
  eventCode        String   @unique @db.VarChar(50)
  eventType        String   @db.VarChar(100)
  severity         String   @default("HIGH") @db.VarChar(20)
  userId           String?  @db.Uuid
  ipAddress        String   @db.VarChar(45)
  details          String   @db.Text
  timestamp        DateTime @default(now()) @db.Timestamptz

  @@map("sec_security_events")
  @@schema("security")
}

model SecComplianceItem {
  id               String   @id @default(uuid()) @db.Uuid
  itemCode         String   @unique @db.VarChar(50)
  title            String   @db.VarChar(200)
  standardName     String   @db.VarChar(100)
  status           String   @default("COMPLIANT") @db.VarChar(30)
  lastAuditedDate  DateTime @db.Date

  @@map("sec_compliance_items")
  @@schema("security")
}

model SecVulnerability {
  id               String   @id @default(uuid()) @db.Uuid
  vulnCode         String   @unique @db.VarChar(50)
  cveId            String?  @db.VarChar(50)
  title            String   @db.VarChar(200)
  riskRating       String   @default("LOW") @db.VarChar(20)
  status           String   @default("PATCHED") @db.VarChar(30)

  @@map("sec_vulnerabilities")
  @@schema("security")
}

model SecAccessReview {
  id               String   @id @default(uuid()) @db.Uuid
  reviewCode       String   @unique @db.VarChar(50)
  userId           String   @db.Uuid
  roleName         String   @db.VarChar(50)
  status           String   @default("CERTIFIED") @db.VarChar(30)
  certifiedAt      DateTime @default(now()) @db.Timestamptz

  @@map("sec_access_reviews")
  @@schema("security")
}

model SecDataPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  policyCode       String   @unique @db.VarChar(50)
  policyName       String   @db.VarChar(150)
  retentionDays    Int      @default(3650)
  isActive         Boolean  @default(true)

  @@map("sec_data_policies")
  @@schema("security")
}

model SecReadinessCert {
  id               String   @id @default(uuid()) @db.Uuid
  certCode         String   @unique @db.VarChar(50)
  districtId       String   @unique @db.Uuid
  securityScore    Decimal  @db.Decimal(5, 2)
  complianceScore  Decimal  @db.Decimal(5, 2)
  isCertified      Boolean  @default(true)
  certifiedAt      DateTime @default(now()) @db.Timestamptz

  @@map("sec_readiness_certs")
  @@schema("security")
}

// ============================================================================
// PHASE C STATEWIDE SCALE TABLES (v1.2) (schema: "scale")
// ============================================================================
model ScaleDistrictOperation {
  id               String               @id @default(uuid()) @db.Uuid
  districtId       String               @unique @db.Uuid
  stage            DistrictRolloutStage @default(NOT_STARTED)
  readinessScore   Decimal              @db.Decimal(5, 2)
  isProductionLive Boolean              @default(false)
  activatedAt      DateTime?            @db.Timestamptz

  createdAt        DateTime             @default(now()) @db.Timestamptz
  updatedAt        DateTime             @updatedAt @db.Timestamptz

  @@map("scale_district_operations")
  @@schema("scale")
}

model ScaleLabRouting {
  id               String   @id @default(uuid()) @db.Uuid
  primaryLabId     String   @db.Uuid
  backupLabId      String   @db.Uuid
  autoFailoverActive Boolean @default(true)
  maxCapacityPerDay Int     @default(200)
  currentLoadPct   Decimal  @db.Decimal(5, 2)

  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@map("scale_lab_routings")
  @@schema("scale")
}

model ScaleWorkforceCapacity {
  id               String   @id @default(uuid()) @db.Uuid
  districtId       String   @unique @db.Uuid
  sanctionedPosts  Int      @default(100)
  filledPosts      Int      @default(80)
  vacantPosts      Int      @default(20)
  capacityScore    Decimal  @db.Decimal(5, 2)

  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@map("scale_workforce_capacities")
  @@schema("scale")
}

model ScaleReliabilityCheck {
  id               String   @id @default(uuid()) @db.Uuid
  serviceName      String   @db.VarChar(100)
  healthStatus     String   @default("HEALTHY") @db.VarChar(30)
  p99LatencyMs     Decimal  @db.Decimal(7, 2)
  circuitBreakerOpen Boolean @default(false)
  checkedAt        DateTime @default(now()) @db.Timestamptz

  @@map("scale_reliability_checks")
  @@schema("scale")
}

model ScaleDrSimulation {
  id               String   @id @default(uuid()) @db.Uuid
  simulationCode   String   @unique @db.VarChar(50)
  pitrValidated    Boolean  @default(true)
  restoreTimeSec   Int      @default(45)
  status           String   @default("SUCCESS") @db.VarChar(30)
  testedAt         DateTime @default(now()) @db.Timestamptz

  @@map("scale_dr_simulations")
  @@schema("scale")
}

model ScaleRolloutWave {
  id               String   @id @default(uuid()) @db.Uuid
  waveName         String   @unique @db.VarChar(50)
  targetDistricts  Int      @default(8)
  status           String   @default("PLANNED") @db.VarChar(30)
  plannedStartDate DateTime @db.Date

  createdAt        DateTime @default(now()) @db.Timestamptz

  @@map("scale_rollout_waves")
  @@schema("scale")
}

// ============================================================================
// OPERATIONAL EXCELLENCE TABLES (v1.1) (schema: "ops")
// ============================================================================
model OpsIncident {
  id               String           @id @default(uuid()) @db.Uuid
  incidentCode     String           @unique @db.VarChar(50)
  title            String           @db.VarChar(200)
  description      String           @db.Text
  severity         IncidentSeverity @default(P3_MINOR)
  status           IncidentStatus   @default(LOGGED)
  moduleName       String           @db.VarChar(50)
  districtId       String?          @db.Uuid
  reportedByUserId String           @db.Uuid
  assignedToUserId String?          @db.Uuid
  rootCauseAnalysis String?         @db.Text
  resolutionNotes  String?          @db.Text

  createdAt        DateTime         @default(now()) @db.Timestamptz
  createdBy        String           @db.Uuid
  updatedAt        DateTime         @updatedAt @db.Timestamptz
  updatedBy        String           @db.Uuid
  deletedAt        DateTime?        @db.Timestamptz
  deletedBy        String?          @db.Uuid
  isDeleted        Boolean          @default(false)
  recordVersion    Int              @default(1)

  @@map("ops_incidents")
  @@schema("ops")
}

model OpsFeatureRequest {
  id               String   @id @default(uuid()) @db.Uuid
  requestCode      String   @unique @db.VarChar(50)
  title            String   @db.VarChar(200)
  description      String   @db.Text
  targetRelease    String   @default("v1.1.0") @db.VarChar(20)
  status           String   @default("UNDER_REVIEW") @db.VarChar(30)
  requestedByUserId String  @db.Uuid

  createdAt        DateTime @default(now()) @db.Timestamptz
  createdBy        String   @db.Uuid
  updatedAt        DateTime @updatedAt @db.Timestamptz
  updatedBy        String   @db.Uuid
  deletedAt        DateTime? @db.Timestamptz
  deletedBy        String?  @db.Uuid
  isDeleted        Boolean  @default(false)
  recordVersion    Int      @default(1)

  @@map("ops_feature_requests")
  @@schema("ops")
}

model OpsUserFeedback {
  id               String   @id @default(uuid()) @db.Uuid
  feedbackCode     String   @unique @db.VarChar(50)
  userRole         String   @db.VarChar(50)
  rating           Int      @default(5)
  comments         String   @db.Text
  moduleName       String   @db.VarChar(50)
  districtId       String?  @db.Uuid
  submittedAt      DateTime @default(now()) @db.Timestamptz

  @@map("ops_user_feedbacks")
  @@schema("ops")
}

model OpsRelease {
  id               String   @id @default(uuid()) @db.Uuid
  versionNumber    String   @unique @db.VarChar(20)
  releaseTitle     String   @db.VarChar(150)
  releaseNotes     String   @db.Text
  rollbackPlan     String   @db.Text
  status           String   @default("PLANNED") @db.VarChar(30)
  deployedAt       DateTime? @db.Timestamptz

  createdAt        DateTime @default(now()) @db.Timestamptz
  createdBy        String   @db.Uuid

  @@map("ops_releases")
  @@schema("ops")
}

model OpsKnowledgeBase {
  id               String   @id @default(uuid()) @db.Uuid
  docCode          String   @unique @db.VarChar(50)
  title            String   @db.VarChar(200)
  category         String   @db.VarChar(50)
  contentMarkdown  String   @db.Text
  targetRole       String   @db.VarChar(50)

  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@map("ops_knowledge_bases")
  @@schema("ops")
}

model OpsRolloutPlan {
  id               String   @id @default(uuid()) @db.Uuid
  planCode         String   @unique @db.VarChar(50)
  districtId       String   @unique @db.Uuid
  readinessScore   Decimal  @db.Decimal(5, 2)
  readinessStatus  String   @default("READY") @db.VarChar(30)
  targetRolloutDate DateTime @db.Date

  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@map("ops_rollout_plans")
  @@schema("ops")
}

// ============================================================================
// PLATFORM CORE SHARED TABLES (schema: "platform")
// ============================================================================
model PlatformUser {
  id               String       @id @default(uuid()) @db.Uuid
  userCode         String       @unique @db.VarChar(50)
  fullName         String       @db.VarChar(150)
  mobileNumber     String       @unique @db.VarChar(15)
  email            String?      @db.VarChar(100)
  roleType         UserRoleType @default(MAHA_AGRIDOOT)
  districtId       String?      @db.Uuid
  talukaId         String?      @db.Uuid
  villageId        String?      @db.Uuid
  isActive         Boolean      @default(true)
  isOtpVerified    Boolean      @default(false)

  createdAt        DateTime     @default(now()) @db.Timestamptz
  createdBy        String       @db.Uuid
  updatedAt        DateTime     @updatedAt @db.Timestamptz
  updatedBy        String       @db.Uuid
  deletedAt        DateTime?    @db.Timestamptz
  deletedBy        String?      @db.Uuid
  isDeleted        Boolean      @default(false)
  recordVersion    Int          @default(1)

  sessions         PlatformSession[]
  auditLogs        PlatformAuditLog[]

  @@map("platform_users")
  @@schema("platform")
}

model PlatformSession {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  sessionToken     String       @unique @db.Text
  refreshToken     String       @unique @db.Text
  ipAddress        String       @db.VarChar(45)
  userAgent        String       @db.Text
  expiresAt        DateTime     @db.Timestamptz
  createdAt        DateTime     @default(now()) @db.Timestamptz

  user             PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_sessions")
  @@schema("platform")
}

model PlatformDistrictMaster {
  id               String   @id @default(uuid()) @db.Uuid
  districtCode     String   @unique @db.VarChar(50)
  districtNameEn   String   @db.VarChar(100)
  districtNameMr   String   @db.VarChar(100)
  divisionName     String   @db.VarChar(100)
  isActive         Boolean  @default(true)

  @@map("platform_district_masters")
  @@schema("platform")
}

model PlatformTalukaMaster {
  id               String   @id @default(uuid()) @db.Uuid
  talukaCode       String   @unique @db.VarChar(50)
  districtId       String   @db.Uuid
  talukaNameEn     String   @db.VarChar(100)
  talukaNameMr     String   @db.VarChar(100)
  isActive         Boolean  @default(true)

  @@map("platform_taluka_masters")
  @@schema("platform")
}

model PlatformNotificationQueue {
  id               String              @id @default(uuid()) @db.Uuid
  channel          NotificationChannel
  recipient        String              @db.VarChar(100)
  messageText      String              @db.Text
  templateId       String?             @db.VarChar(50)
  status           String              @default("QUEUED") @db.VarChar(30)
  attemptCount     Int                 @default(0)
  deliveredAt      DateTime?           @db.Timestamptz
  createdAt        DateTime            @default(now()) @db.Timestamptz

  @@map("platform_notification_queues")
  @@schema("platform")
}

model PlatformVaultFile {
  id               String   @id @default(uuid()) @db.Uuid
  fileCode         String   @unique @db.VarChar(50)
  originalName     String   @db.VarChar(255)
  mimeType         String   @db.VarChar(100)
  fileSizeByte     BigInt
  fileStoragePath  String   @db.Text
  publicUrl        String   @db.Text
  fileHashSha256   String   @db.Char(64)
  digitalSignature String?  @db.Text
  uploadedByUserId String   @db.Uuid
  uploadedAt       DateTime @default(now()) @db.Timestamptz

  @@map("platform_vault_files")
  @@schema("platform")
}

model PlatformAuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String?         @db.Uuid
  actionType       AuditActionType
  moduleName       String          @db.VarChar(50)
  resourceName     String          @db.VarChar(100)
  actionDetails    String          @db.Text
  ipAddress        String          @db.VarChar(45)
  timestamp        DateTime        @default(now()) @db.Timestamptz

  user             PlatformUser?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("platform_audit_logs")
  @@schema("platform")
}

model PlatformSystemConfig {
  id               String   @id @default(uuid()) @db.Uuid
  configKey        String   @unique @db.VarChar(100)
  configValue      String   @db.Text
  description      String?  @db.Text
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@map("platform_system_configs")
  @@schema("platform")
}

// ----------------------------------------------------------------------------
// SHARED FARMER MASTER TABLES (schema: "farmer")
// ----------------------------------------------------------------------------
model SharedFarmerProfile {
  id               String             @id @default(uuid()) @db.Uuid
  farmerCode       String             @unique @db.VarChar(50)
  fullName         String             @db.VarChar(150)
  mobileNumber     String             @unique @db.VarChar(15)
  aadhaarHash      String             @db.Char(64)
  districtId       String             @db.Uuid
  talukaId         String             @db.Uuid
  villageId        String             @db.Uuid
  status           SharedFarmerStatus @default(REGISTERED)
  isKycVerified    Boolean            @default(false)
  householdId      String?            @db.Uuid

  createdAt        DateTime           @default(now()) @db.Timestamptz
  createdBy        String             @db.Uuid
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  updatedBy        String             @db.Uuid
  deletedAt        DateTime?          @db.Timestamptz
  deletedBy        String?            @db.Uuid
  isDeleted        Boolean            @default(false)
  recordVersion    Int                @default(1)

  landHoldings     SharedFarmerLandHolding[]
  serviceLinks     SharedFarmerServiceLink[]
  timelines        SharedFarmerTimeline[]

  @@map("shared_farmer_profiles")
  @@schema("farmer")
}

model SharedFarmerLandHolding {
  id               String              @id @default(uuid()) @db.Uuid
  farmerId         String              @db.Uuid
  surveyNumber     String              @db.VarChar(50)
  gatNumber        String?             @db.VarChar(50)
  totalAreaAcres   Decimal             @db.Decimal(8, 2)
  districtId       String              @db.Uuid
  talukaId         String              @db.Uuid
  villageId        String              @db.Uuid

  farmer           SharedFarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("shared_farmer_land_holdings")
  @@schema("farmer")
}

model SharedFarmerServiceLink {
  id               String              @id @default(uuid()) @db.Uuid
  farmerId         String              @db.Uuid
  moduleName       String              @db.VarChar(50)
  serviceRefCode   String              @db.VarChar(100)
  linkedAt         DateTime            @default(now()) @db.Timestamptz

  farmer           SharedFarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("shared_farmer_service_links")
  @@schema("farmer")
}

model SharedFarmerTimeline {
  id             String               @id @default(uuid()) @db.Uuid
  farmerId       String               @db.Uuid
  previousStatus SharedFarmerStatus?
  newStatus      SharedFarmerStatus
  actorUserId    String               @db.Uuid
  actionSummary  String               @db.VarChar(255)
  createdAt      DateTime             @default(now()) @db.Timestamptz

  farmer         SharedFarmerProfile  @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("shared_farmer_timelines")
  @@schema("farmer")
}

// ----------------------------------------------------------------------------
// WORKFORCE MODULE TABLES (schema: "workforce")
// ----------------------------------------------------------------------------
model WorkforceProfile {
  id               String          @id @default(uuid()) @db.Uuid
  agridootCode     String          @unique @db.VarChar(50)
  fullName         String          @db.VarChar(150)
  mobileNumber     String          @unique @db.VarChar(15)
  email            String?         @db.VarChar(100)
  aadhaarHash      String          @db.Char(64)
  districtId       String          @db.Uuid
  talukaId         String          @db.Uuid
  assignedVillage  String          @db.VarChar(100)
  status           WorkforceStatus @default(APPLIED)
  isIdentityCardIssued Boolean     @default(false)
  
  createdAt        DateTime        @default(now()) @db.Timestamptz
