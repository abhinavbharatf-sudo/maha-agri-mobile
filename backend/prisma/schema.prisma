  recordVersion    Int      @default(1)

  landParcels      SoilLandParcel[]
  samples          SoilSample[]

  @@map("soil_farmers")
  @@schema("soil")
}

model SoilLandParcel {
  id               String       @id @default(uuid()) @db.Uuid
  parcelCode       String       @unique @db.VarChar(50)
  farmerId         String       @db.Uuid
  surveyNumber     String       @db.VarChar(50)
  gatNumber        String?      @db.VarChar(50)
  totalAreaAcres   Decimal      @db.Decimal(8, 2)
  districtId       String       @db.Uuid
  talukaId         String       @db.Uuid
  villageId        String       @db.Uuid
  gpsCenterLat     Float?
  gpsCenterLng     Float?

  createdAt        DateTime     @default(now()) @db.Timestamptz
  createdBy        String       @db.Uuid
  updatedAt        DateTime     @updatedAt @db.Timestamptz
  updatedBy        String       @db.Uuid
  deletedAt        DateTime?    @db.Timestamptz
  deletedBy        String?      @db.Uuid
  isDeleted        Boolean      @default(false)
  recordVersion    Int          @default(1)

  farmer           SoilFarmer   @relation(fields: [farmerId], references: [id])
  samples          SoilSample[]

  @@map("soil_land_parcels")
  @@schema("soil")
}

model SoilLaboratory {
  id               String   @id @default(uuid()) @db.Uuid
  labCode          String   @unique @db.VarChar(50)
  labName          String   @db.VarChar(200)
  labType          LabType  @default(GOVERNMENT_LAB)
  districtId       String   @db.Uuid
  address          String   @db.Text
  nablAccreditationNo String? @db.VarChar(100)
  isOperational    Boolean  @default(true)

  createdAt        DateTime @default(now()) @db.Timestamptz
  createdBy        String   @db.Uuid
  updatedAt        DateTime @updatedAt @db.Timestamptz
  updatedBy        String   @db.Uuid
  deletedAt        DateTime? @db.Timestamptz
  deletedBy        String?  @db.Uuid
  isDeleted        Boolean  @default(false)
  recordVersion    Int      @default(1)

  assignments      SoilSampleAssignment[]

  @@map("soil_laboratories")
  @@schema("soil")
}

model SoilSample {
  id                 String             @id @default(uuid()) @db.Uuid
  sampleCode         String             @unique @db.VarChar(50)
  qrCode             String             @unique @db.VarChar(100)
  barcodeNumber      String             @unique @db.VarChar(50)
  farmerId           String             @db.Uuid
  parcelId           String             @db.Uuid
  agridootUserId     String             @db.Uuid
  collectionDepthCm  Int                @default(15)
  collectionLat      Float
  collectionLng      Float
  collectionTimestamp DateTime          @default(now()) @db.Timestamptz
  priority           SoilSamplePriority @default(NORMAL)
  status             SoilSampleStatus   @default(SAMPLE_COLLECTED)

  createdAt          DateTime           @default(now()) @db.Timestamptz
  createdBy          String             @db.Uuid
  updatedAt          DateTime           @updatedAt @db.Timestamptz
  updatedBy          String             @db.Uuid
  deletedAt          DateTime?          @db.Timestamptz
  deletedBy          String?            @db.Uuid
  isDeleted          Boolean            @default(false)
  recordVersion      Int                @default(1)

  farmer             SoilFarmer         @relation(fields: [farmerId], references: [id])
  landParcel         SoilLandParcel     @relation(fields: [parcelId], references: [id])
  visits             SoilCollectionVisit[]
  assignments        SoilSampleAssignment[]
  custodyRecords     SoilChainOfCustody[]
  timelines          SoilSampleTimeline[]
  labTest            SoilLabTest?
  qcReviews          SoilQcReview[]
  healthCard         SoilHealthCard?
  healthCardVersions SoilHealthCardVersion[]
  recommendations    SoilCropRecommendation[]
  tasks              SoilTask[]
  notifications      SoilNotification[]
  activityLogs       SoilActivityLog[]

  @@map("soil_samples")
  @@schema("soil")
}

model SoilCollectionVisit {
  id                 String     @id @default(uuid()) @db.Uuid
  sampleId           String     @db.Uuid
  visitDate          DateTime   @default(now()) @db.Timestamptz
  agridootUserId     String     @db.Uuid
  gpsLatitude        Float
  gpsLongitude       Float
  collectionStatus   String     @db.VarChar(30)
  remarks            String?    @db.Text
  photoEvidenceUrl   String?    @db.Text

  sample             SoilSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@map("soil_collection_visits")
  @@schema("soil")
}

model SoilSampleAssignment {
  id                 String         @id @default(uuid()) @db.Uuid
  sampleId           String         @db.Uuid
  labId              String         @db.Uuid
  assignedDate       DateTime       @default(now()) @db.Timestamptz
  receivedDate       DateTime?      @db.Timestamptz
  expectedCompletion DateTime?      @db.Date
  currentLabStatus   String         @default("ASSIGNED") @db.VarChar(30)

  sample             SoilSample     @relation(fields: [sampleId], references: [id], onDelete: Cascade)
