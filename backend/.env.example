# ============================================================================
# MAHA-AGRI Government Digital Operations Platform
# Backend Environment Variable Matrix (.env.example)
# ============================================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database Configuration (PostgreSQL 16 Multi-Schema Engine)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maha_agri_db?schema=platform"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/maha_agri_db?schema=platform"

# 3. Authentication & JWT Tokens
JWT_SECRET=MahaAgriDevelopmentJwtSecretKeyPlaceholder2026
JWT_EXPIRES_IN=86400s
REFRESH_TOKEN_EXPIRES_IN=604800s

# 4. Email / SMTP Gateway Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=smtp_user_placeholder
SMTP_PASS=smtp_pass_placeholder

# 5. WhatsApp & CDAC SMS Gateway Configuration
WHATSAPP_BUSINESS_API_TOKEN=whatsapp_token_placeholder
CDAC_SMS_GATEWAY_URL=https://sms.cdac.gov.in/api/v1/send

# 6. Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# 7. Document Security & Digital Signature
RSA_PRIVATE_KEY=rsa_private_key_placeholder

# 8. Caching & Queue Management (Redis)
REDIS_URL=redis://localhost:6379

# 9. External Supabase Integration (Optional/Legacy)
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key_placeholder
